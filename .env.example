# Copy this file to .env and edit. .env is git-ignored. NEVER commit your key.

# --- LLM provider (any OpenAI-compatible API; default shown is Groq's free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-key-here
# Verify this model ID is currently listed in your provider console before running
LLM_MODEL=openai/gpt-oss-20b

# --- Generation settings (kept fixed for reproducibility) ---
LLM_TEMPERATURE=0
LLM_SEED=42
# Reasoning models spend part of this budget on hidden reasoning, so keep it generous
LLM_MAX_TOKENS=1024
# Optional, only for reasoning models that support it (low | medium | high). Leave empty otherwise.
LLM_REASONING_EFFORT=
# Pause between calls (seconds) to stay under free-tier rate limits. Not counted in latency.
CALL_DELAY_SECONDS=3

# --- Pricing (USD per 1,000,000 tokens) ---
# Copy from the provider's published pricing page for the SAME model. Placeholders below.
PRICE_INPUT_PER_M=0.00
PRICE_OUTPUT_PER_M=0.00
PRICING_SOURCE=PLACEHOLDER - provider name and URL
PRICING_DATE=PLACEHOLDER - date checked
PRICING_CURRENCY=USD

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Report cover (optional) ---
STUDENT_NAME=Your Name
STUDENT_ID=Your ID
